# Circle API key (server-side, secret). Used for the wallets and Borrow Kit.
CIRCLE_API_KEY=your_circle_api_key_here

# Borrow Kit endpoint.
BORROW_BASE_URL=https://api.circle.com

# Arc Testnet RPC override (optional — Borrow Kit defaults to a public RPC).
# BORROW_RPC_URL=

# Circle app ID used by the W3S PIN/passkey widget in the browser.
NEXT_PUBLIC_CIRCLE_APP_ID=your_circle_app_id_here

# Supabase project — provides email/password auth and stores the
# wallet_accounts / activity_log tables (see supabase/migrations/0001_init.sql).
# Both are safe to expose to the browser; RLS scopes all access to auth.uid().
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase secret key (server-side, secret — never expose to the client). Used only to save
# the user's wallet in wallet_accounts, which users can no longer write themselves. Local
# stack: `supabase status -o env` prints it as SECRET_KEY.
SUPABASE_SECRET_KEY=your_supabase_secret_key_here

# Optional — defaults to 3000 via `next dev`/`next start`.
PORT=
